// Lisio tourne en local avec « wrangler dev » : la base (D1) et les fichiers (R2) sont simulés sur ce PC, dans le dossier data/.
// Aucun compte Cloudflare n'est nécessaire ; les identifiants ci-dessous ne servent qu'en local.
{
  "name": "lisio",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/books/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lisio", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "lisio-books" }
  ]
}
